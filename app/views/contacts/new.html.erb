
<%# app/views/contacts/new.html.erb %>
<%= turbo_frame_tag "modal" do %>
  <div data-controller="modal">
    <dialog data-modal-target="dialog" class="rounded-xl p-6">

      <div class="mb-8">
  <h2 class="text-2xl font-bold text-gray-900">Add Contact</h2>
  <p class="text-sm text-gray-500">Enter the details of your new contact below.</p>
</div>
      <%= render "form", contact: @contact %>
    </dialog>
  </div>
<% end %>