<%= turbo_frame_tag "contacts_list" do %>
  <div class="space-y-4" data-controller="bulk-actions">
    <div class="space-y-4" data-controller="bulk-actions">
      <div class="flex flex-col sm:flex-row sm:items-center justify-end gap-4 mb-4">
        <div class="flex items-center gap-2">
          <%# --- Mobile Select All Button (Hidden on Desktop) --- %>
          <button type="button" 
                data-action="click->bulk-actions#toggleAll"
            class="md:hidden inline-flex items-center px-4 py-3.5 text-sm font-bold text-white bg-gray-700 border border-indigo-100 rounded-xl active:scale-95 transition-transform">
            <span data-bulk-actions-target="selectAllText">Select All</span>
          </button>
          <%# --- Dropdown: Export Actions --- %>
          <div class="relative group">
            <button type="button" class="inline-flex items-center gap- px-4 py-3.5 text-sm font-semibold text-gray-700 bg-white border border-gray-200 rounded-xl shadow-sm hover:bg-gray-50">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              Export
              <svg class="w-4 h-4 ml-1" fill="currentColor" viewBox="0 0 20 20"><path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"/></svg>
            </button>
            <%# Dropdown Menu (Shows on Hover for simplicity, or use Alpine/Stimulus for click) %>
            <div class="absolute right-0 w-56 mt-2 origin-top-right bg-white border border-gray-100 rounded-xl shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50">
              <div class="p-1">
                <%# Option A: Export Selected %>
                <%= button_tag type: "submit", name: "bulk_action", value: "export", form: "bulk-actions-form", 
                  class: "flex w-full items-center px-4 py-2 text-sm text-gray-700 rounded-lg hover:bg-gray-50 hover:text-indigo-600", 
                  data: { bulk_actions_target: "exportButton", turbo: false } do %>
                  <span data-bulk-actions-target="exportSelectedText">Export Selected (0)</span>
                <% end %>
                <%# Option B: Export All (Static Link) %>
                <%= link_to contacts_path(format: :csv, query: params[:query]), 
                  class: "hover:no-underline flex items-center px-4 py-2 text-sm text-gray-700 rounded-lg hover:bg-gray-50", 
                  data: { turbo: false } do %>
                  Export All Contacts
                <% end %>
              </div>
            </div>
          </div>
          <%# --- Dynamic Button: Add OR Delete --- %>
          <%# Delete Button (Hidden by default) %>
          <%= button_tag type: "submit", name: "bulk_action", value: "delete", form: "bulk-actions-form", 
            class: "hidden inline-flex items-center gap-2 px-5 py-2.5 text-sm font-semibold text-white bg-red-600 border border-red-600 rounded-xl shadow-sm transition hover:bg-red-700", 
            data: { 
              bulk_actions_target: "deleteButton",
              turbo_confirm: "Are you sure you want to delete the selected contacts?" 
            } do %>
            <span class="text-lg">×</span>
            <span>Delete Selected</span>
          <% end %>
          <%# Add Contact Button (Visible by default) %>
          <%= link_to new_contact_path,
            data: { bulk_actions_target: "addButton", turbo: false },
            class: "inline-flex items-center gap-2 px-5 py-2.5 text-sm font-semibold text-white bg-indigo-600 rounded-xl shadow-md transition-all hover:bg-indigo-700 active:scale-95" do %>
            <span class="text-lg">+</span>
            <span>Add Contact</span>
          <% end %>
        </div>
      </div>

      <%# We wrap the entire content in a form to capture checkbox selections %>
      <%= form_with url: bulk_actions_contacts_path, method: :post, data: { turbo_frame: "_top" }, id: "bulk-actions-form" do |f| %>
        <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm">
          <%# --- Desktop Table View --- %>
          <div class="hidden md:block">
  <%# --- Wrapper for the scrollable area --- %>
  <div class="overflow-y-auto max-h-[600px] border border-gray-200 rounded-xl no-scrollbar">
    <table class="w-full text-sm border-collapse">
      <%# --- sticky top-0 keeps the header at the top while scrolling --- %>
      <thead class="bg-gray-50 sticky top-0 z-10 border-b border-gray-200 shadow-sm">
        <tr>
          <th class="w-12 px-6 py-4 bg-gray-50">
            <input type="checkbox" data-action="change->bulk-actions#toggleAll" class="rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer">
          </th>
          <th class="px-6 py-4 text-left text-xs font-bold uppercase text-gray-400">Name</th>
          <th class="px-6 py-4 text-left text-xs font-bold uppercase text-gray-400">Phone</th>
          <th class="px-6 py-4 text-right text-xs font-bold uppercase text-gray-400">Actions</th>
        </tr>
      </thead>

      <tbody class="divide-y divide-gray-100 bg-white">
        <% if @contacts.empty? %>
          <tr>
            <td colspan="4" class="text-center py-16 text-gray-400 italic">No contacts found matching your criteria.</td>
          </tr>
        <% else %>
          <% @contacts.each do |contact| %>
            <tr id="<%= dom_id(contact) %>" class="hover:bg-gray-50 transition-colors group">
              <td class="px-6 py-4">
                <%= check_box_tag "contact_ids[]", contact.id, false, 
                    class: "contact-checkbox rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer",
                    data: { bulk_actions_target: "checkbox", action: "change->bulk-actions#update" } %>
              </td>
              <td class="px-6 py-4">
                <div class="flex items-center gap-3">
                  <div class="w-9 h-9 rounded-xl bg-indigo-50 flex items-center justify-center text-xs font-bold text-indigo-600 group-hover:bg-indigo-100">
                    <%= contact.first_name[0] %><%= contact.last_name[0] %>
                  </div>
                  <span class="font-semibold text-gray-900"><%= contact.first_name %> <%= contact.last_name %></span>
                </div>
              </td>
              <td class="px-6 py-4 font-mono text-gray-600"><%= contact.phone_number %></td>
              <td class="px-6 py-4 text-right">
                <div class="flex justify-end gap-2">
                  <%= link_to 'Edit', edit_contact_path(contact), class: "px-3 py-1.5 text-xs font-bold text-blue-600 bg-blue-50 rounded-lg hover:bg-blue-100 transition-colors", data: { turbo: false } %>
                  <%= link_to 'Delete', contact_path(contact), data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, class: "px-3 py-1.5 text-xs font-bold text-red-600 bg-red-50 rounded-lg hover:bg-red-100 transition-colors" %>
                </div>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

          <%# --- Mobile Card View --- %>
          <div class="md:hidden divide-y divide-gray-100">
            <% if @contacts.empty? %>
              <div class="text-center py-12 text-gray-400">No contacts found.</div>
            <% else %>
              <% @contacts.each do |contact| %>
                <div id="mobile_<%= dom_id(contact) %>" 
                  data-bulk-actions-target="card"
                  class="p-4 transition-colors border-l-4 border-transparent bg-white">
                  <div class="flex items-start justify-between">
                    <div class="flex items-center gap-4">
                      <%# Checkbox: Triggers the highlight update %>
                      <%= check_box_tag "contact_ids[]", contact.id, false, 
                        class: "contact-checkbox rounded border-gray-300 text-indigo-600 focus:ring-indigo-500",
                        data: { 
                          bulk_actions_target: "checkbox", 
                          action: "change->bulk-actions#update" 
                        } %>
                      <div class="w-10 h-10 rounded-xl bg-indigo-50 flex items-center justify-center text-xs font-bold text-indigo-600">
                        <%= contact.first_name[0] %><%= contact.last_name[0] %>
                      </div>
                      <div>
                        <div class="font-bold text-gray-900"><%= contact.first_name %> <%= contact.last_name %></div>
                        <div class="text-xs font-mono text-gray-500 mt-0.5"><%= contact.phone_number %></div>
                      </div>
                    </div>
                    <%# Edit Link - Still visible but subtle %>
                    <%= link_to edit_contact_path(contact), class: "text-gray-400 p-2", data: { turbo: false } do %>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                      </svg>
                    <% end %>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %> <%# End form_with %>
    </div>
  <% end %>
