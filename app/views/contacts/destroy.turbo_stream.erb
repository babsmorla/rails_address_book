<%# 1. Remove the contact row from the table %>
<%= turbo_stream.remove dom_id(@contact) %>

<%# 2. Update the count in the stats row %>
<%= turbo_stream.update "contacts_count" do %>
  <%= current_user.contacts.count %>
<% end %>

<%# 3. Reset the profile sidebar to the empty state %>
<%= turbo_stream.replace "profile_sidebar" do %>
  <%= turbo_frame_tag "profile_sidebar" do %>
    <div class="p-8 flex flex-col items-center text-center scrollbar-hidden">
       <span class="text-xs font-bold text-gray-300 tracking-widest mb-4">No Contact Selected</span>
      <div class="h-48 w-48 rounded-full bg-gray-50 border-8 border-gray-50 shadow-inner mb-6 overflow-hidden flex items-center justify-center">
         <svg class="h-24 w-24 text-gray-200" fill="currentColor" viewBox="0 0 24 24">
           <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
         </svg>
      </div>
      <h2 class="text-2xl font-bold text-gray-400 italic text-emerald-900/20">Select a record</h2>
      <p class="text-sm text-red-300 mt-2">The previous contact was removed successfully.</p>
    </div>
  <% end %>
<% end %>

<%# 4. Trigger the Flash Message popover %>
<%= turbo_stream.update "flash" do %>
  <%= render "layouts/flash" %>
<% end %>