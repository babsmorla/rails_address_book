<%= form_with model: @contact, class: "space-y-6" do |f| %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <%# First Name %>
    <div class="flex flex-col gap-1.5">
      <%= f.label :first_name, class: "text-sm font-semibold text-gray-700" %>
      <%= f.text_field :first_name, 
            required: true,
            placeholder: "e.g. Ebo", 
            class: "block w-full px-4 py-3 rounded-xl border-gray-300 shadow-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all placeholder:text-gray-400" %>
    </div>

    <%# Last Name %>
    <div class="flex flex-col gap-1.5">
      <%= f.label :last_name, class: "text-sm font-semibold text-gray-700" %>
      <%= f.text_field :last_name, 
            required: true,
            placeholder: "e.g. Rice", 
            class: "block w-full px-4 py-3 rounded-xl border-gray-300 shadow-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all placeholder:text-gray-400" %>
    </div>

    <%# User Assignment (Admin Only) %>
    <% if current_user.admin? %>
      <div class="flex flex-col gap-1.5 md:col-span-2">
        <%= f.label :user_id, "Assign to User", class: "text-sm font-semibold text-gray-700" %>
        <%= f.collection_select :user_id, User.where(admin_role_code: 'usr'), :id, :username, 
              { prompt: "Select a standard user" }, 
              { class: "block w-full px-4 py-3 rounded-xl border-gray-300 shadow-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all" } %>
      </div>
    <% end %>
  </div>

  <%# Phone Number %>
  <div class="flex flex-col gap-1.5">
    <%= f.label :phone_number, "Phone Number", class: "text-sm font-semibold text-gray-700" %>
    <%= f.text_field :phone_number,
          placeholder: "e.g. 0244123456",
          required: true,
          maxlength: 10,  
          class: "block w-full px-4 py-3 rounded-xl border-gray-300 shadow-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all placeholder:text-gray-400" %>
    
    <% if @contact.errors[:phone_number].any? %>
      <p class="text-red-500 text-xs mt-1">
        <%= @contact.errors[:phone_number].first %>
      </p>
    <% end %>
  </div>

  <%# Form Actions %>
  <div class="pt-4 flex items-center justify-end gap-3 border-t border-gray-100">
    <%# The Close Button for the Modal %>
    <button type="button" 
            data-action="click->modal#close" 
            class="px-6 py-2.5 bg-gray-100 text-gray-700 text-sm font-semibold rounded-xl hover:bg-gray-200 transition-all">
      Cancel
    </button>

    <%= f.submit "Save Contact", 
          class: "px-6 py-2.5 bg-indigo-600 text-white text-sm font-semibold rounded-xl shadow-md hover:bg-indigo-700 focus:ring-4 focus:ring-indigo-500/30 transition-all cursor-pointer" %>
  </div>
<% end %>