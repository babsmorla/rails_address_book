
<table class="w-full text-left">
  <thead>
    <tr class="text-gray-900 text-sm font-bold border-b border-gray-50">
      <th class="py-4">Username</th>
      <th class="py-4">Role</th>
      <th class="py-4 text-center">Contacts Created</th>
      <th class="py-4">Email</th>
      <th class="py-4 text-right pr-4">Joined</th>
      <th class="py-4 text-right pr-4">Actions</th>
    </tr>
  </thead>
  <tbody class="text-sm bg-white">
    <% @users.each do |user| %>
      <tr class="group hover:bg-emerald-400 hover:text-gray-600 transition-all cursor-default border-b border-gray-50">
        <td class="py-4">
          <div class="flex items-center gap-3">
            <div class="h-8 w-8 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-700 font-bold group-hover:bg-white group-hover:text-emerald-500">
              <%= user.username[0].upcase %>
            </div>
            <span class="font-semibold"><%= user.username %></span>
          </div>
        </td>
        <td class="py-4">
          <span class="px-2 py-1 bg-gray-100 rounded text-xs font-medium text-gray-600 group-hover:bg-emerald-500 group-hover:text-white border border-transparent group-hover:border-emerald-300">
            <%= user.admin_role&.role_code == 'adm' ? 'Admin' : 'User' %>
          </span>
        </d>
        <td class="py-4 text-center font-mono group-hover:text-gray-500">
          <%= user.contacts.count %>
        </td>
        <td class="py-4 text-gray-500 group-hover:text-gray-600 italic">
          <%= user.email %>
        </td>
        <td class="py-4 text-right pr-4 text-gray-400 group-hover:text-gray-600 text-xs">
          <%= user.created_at.strftime("%d %b %Y") %>
        </td>
        <td class="py-4 text-right pr-4 text-gray-400 group-hover:text-gray-600 text-xs">
          <%# Edit Action %>
          <div class="flex justify-end gap-4">
            <span><%= link_to edit_admin_path(user), 
        class: "text-emerald-600 hover:text-emerald-800 font-medium transition-colors",
        data: { turbo_frame: "_top" } do %>
                Edit
              <% end %></span>
            <%# Delete Action (Corrected for Turbo) %>
            <span>
              <%= button_to admin_path(user), 
        method: :delete, 
        form: { data: { turbo_confirm: "Are you sure you want to delete #{user.username}?, This action cannot be undone." } },
        class: "text-red-500 hover:text-red-700 font-medium transition-colors bg-transparent border-none p-0 cursor-pointer" do %>
                Delete
              <% end %>
            </span>
          </div>
        </div>
      </td>
    </tr>
  <% end %>
</tbody>
</table>
